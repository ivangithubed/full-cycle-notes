---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const siteName = "Повний цикл розробки: конспект IT-Марафону 2026";
const defaultDescription =
  "Неофіційний систематизований конспект відкритих стрімів IT-Марафону 2026: вимоги, дизайн, архітектура, DevOps, хмара, бекенд, фронтенд і роль ШІ на кожному етапі.";

const { pageTitle, description = defaultDescription, ogType = "website" } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/og.png`, Astro.site);
---
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Keep the site out of search engines; link previews in messengers still work -->
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <!-- Open Graph: link preview cards in Telegram, Viber, Facebook, LinkedIn -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Повний цикл розробки — неофіційний конспект IT-Марафону 2026" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
  </head>
  <body>
    <Header />
    <main>
      <h1>{pageTitle}</h1>
      <slot />
    </main>
    <Footer />

    <script>
     import "../scripts/menu.js";
    </script>
  </body>
</html>
