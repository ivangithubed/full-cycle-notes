---
interface Props {
  level: 1 | 2 | 3;
}

const { level } = Astro.props;

// Icons: 1 — eye (know), 2 — open book (understand), 3 — wrench (do)
const icons = {
  1: [
    "M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z",
    "M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z",
  ],
  2: [
    "M2 5h7a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H2z",
    "M22 5h-7a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h8z",
  ],
  3: [
    "M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z",
  ],
};

// Bars hang down like layers of depth: the deeper the level, the more layers are filled
const bars = [1, 2, 3].map((i) => ({
  x: (i - 1) * 16,
  height: 8 + (i - 1) * 9,
  filled: i <= level,
}));
---

<div class="depth-visual" aria-hidden="true">
  <svg class="depth-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    {icons[level].map((d) => <path d={d} />)}
  </svg>
  <div class="depth-meter">
    <svg viewBox="0 0 44 31" width="66" height="46.5">
      <line x1="0" y1="0.75" x2="44" y2="0.75" stroke="currentColor" stroke-width="1.5" />
      {bars.map((bar) => (
        <rect
          x={bar.x + 0.75}
          y="3"
          width="10.5"
          height={bar.height}
          fill={bar.filled ? "currentColor" : "none"}
          stroke="currentColor"
          stroke-width="1.5"
        />
      ))}
    </svg>
    <span class="depth-caption">глибина {level}/3</span>
  </div>
</div>
