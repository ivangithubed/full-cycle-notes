---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
const pageTitle = "Словник професійного жаргону";

type Term = { word: string; origin: string; meaning: string };

const groups: { title: string; terms: Term[] }[] = [
  {
    title: "Процес і команда",
    terms: [
      { word: "фіча", origin: "feature", meaning: "Нова функція продукту. «Беремо в спринт фічу групового замовлення»." },
      { word: "таска", origin: "task", meaning: "Окрема задача в трекері. «На мене засайнили дві таски»." },
      { word: "тікет", origin: "ticket", meaning: "Запис задачі чи бага в трекері (Jira тощо) з описом і статусом." },
      { word: "спринт", origin: "sprint", meaning: "Короткий цикл роботи в Scrum, зазвичай 1–2 тижні, наприкінці якого є готова частина продукту." },
      { word: "беклог", origin: "backlog", meaning: "Впорядкований список усіх задач і ідей продукту, з якого беруть роботу в спринт." },
      { word: "дейлі, стендап", origin: "daily, stand-up", meaning: "Коротка щоденна зустріч команди: що зробив, що робитиму, що заважає." },
      { word: "рекваєрменти", origin: "requirements", meaning: "Вимоги до системи: що вона має робити і як працювати." },
      { word: "юзерсторі", origin: "user story", meaning: "Опис потреби з погляду користувача: «Як [роль], я хочу [дія], щоб [користь]»." },
      { word: "ей-сі, критерії приймання", origin: "acceptance criteria, AC", meaning: "Умови, за яких задачу вважають виконаною." },
      { word: "засайнити", origin: "to assign", meaning: "Призначити задачу на конкретну людину. «Засайни тікет на мене»." },
      { word: "естімейт, заестімейтити", origin: "estimate", meaning: "Оцінка обсягу роботи і сама дія оцінювання." },
      { word: "рефайнмент", origin: "backlog refinement", meaning: "Зустріч, на якій аналітик пояснює команді нові задачі, а команда їх уточнює й оцінює." },
      { word: "ретро", origin: "retrospective", meaning: "Зустріч наприкінці спринту: що вдалося, що ні і що змінити в роботі команди." },
      { word: "демо, демка", origin: "demo", meaning: "Показ готової функціональності клієнту наприкінці спринту." },
      { word: "сторіпоінти", origin: "story points", meaning: "Умовні одиниці складності задачі, якими команда оцінює роботу замість годин." },
      { word: "скоуп", origin: "scope", meaning: "Межі задачі чи проєкту: що входить у роботу, а що ні. «Це поза скоупом»." },
      { word: "дедлайн", origin: "deadline", meaning: "Крайній термін виконання." },
      { word: "квік-він", origin: "quick win", meaning: "Задача, яка дешево робиться і швидко дає помітну користь." },
      { word: "роадмап", origin: "roadmap", meaning: "План розвитку продукту на кілька етапів уперед." },
      { word: "стейкхолдер", origin: "stakeholder", meaning: "Будь-хто, кого цікавить результат проєкту або хто на нього впливає." },
      { word: "фідбек", origin: "feedback", meaning: "Зворотний зв'язок: відгук на роботу, продукт чи рішення." },
      { word: "апрув, апрувнути", origin: "approve", meaning: "Схвалення і дія схвалення. «Тімлід апрувнув пул-реквест»." },
      { word: "блокер", origin: "blocker", meaning: "Те, що не дає рухатися далі. «У мене блокер: немає доступу до хмари»." },
      { word: "ПОшка, продакт", origin: "Product Owner", meaning: "Людина, яка відповідає за цінність продукту і пріоритети беклогу." },
    ],
  },
  {
    title: "Код і Git",
    terms: [
      { word: "репо, репозиторій", origin: "repository", meaning: "Сховище коду з усією історією змін." },
      { word: "склонити", origin: "to clone", meaning: "Завантажити копію репозиторію собі на комп'ютер." },
      { word: "бранч, гілка", origin: "branch", meaning: "Окрема лінія змін у репозиторії. «Зроби фіча-бранч від мейну»." },
      { word: "мейн, мастер", origin: "main, master", meaning: "Головна гілка репозиторію, з якої зазвичай розгортають продукт." },
      { word: "закомітити", origin: "to commit", meaning: "Зафіксувати зміни в історії репозиторію з коротким описом." },
      { word: "запушити", origin: "to push", meaning: "Відправити свої коміти з комп'ютера у віддалений репозиторій." },
      { word: "спулити", origin: "to pull", meaning: "Забрати свіжі зміни з віддаленого репозиторію до себе." },
      { word: "пул-реквест, ПР", origin: "pull request, PR", meaning: "Запит на злиття змін зі своєї гілки в спільну, через який проходить рев'ю." },
      { word: "змержити", origin: "to merge", meaning: "Злити зміни однієї гілки в іншу." },
      { word: "конфлікт", origin: "merge conflict", meaning: "Ситуація, коли дві гілки змінили той самий фрагмент коду і Git не може злити їх сам." },
      { word: "рев'ю, порев'ювати", origin: "code review", meaning: "Перевірка чужого коду перед злиттям." },
      { word: "дифф", origin: "diff", meaning: "Різниця між двома версіями коду: що додали, що прибрали." },
      { word: "рефакторити", origin: "to refactor", meaning: "Переписати код, щоб він став кращим, не змінюючи поведінки." },
      { word: "імплементувати", origin: "to implement", meaning: "Реалізувати: написати код, який робить потрібне." },
      { word: "ліба", origin: "library", meaning: "Бібліотека — готовий код, який підключають у проєкт." },
      { word: "фреймворк", origin: "framework", meaning: "Каркас для застосунку з готовими правилами й інструментами (Angular, React, .NET)." },
      { word: "депенденсі", origin: "dependency", meaning: "Залежність: чужий пакет чи сервіс, без якого твій код не працює." },
      { word: "конфіг", origin: "config", meaning: "Файл налаштувань застосунку чи інструмента." },
      { word: "хардкод, захардкодити", origin: "hardcode", meaning: "Вписати значення прямо в код замість налаштувань. Зазвичай — погана практика." },
      { word: "легасі", origin: "legacy", meaning: "Старий код, який досі працює і який страшно чіпати." },
      { word: "техборг", origin: "tech debt", meaning: "Технічний борг: відкладені «на потім» виправлення й спрощення, які з часом ускладнюють роботу." },
      { word: "костиль", origin: "workaround, hack", meaning: "Тимчасове обхідне рішення, щоб «просто запрацювало». Зазвичай стає техборгом." },
      { word: "лінтер", origin: "linter", meaning: "Інструмент, який автоматично перевіряє код на помилки й відповідність домовленостям команди." },
      { word: "тайпчекінг", origin: "type checking", meaning: "Автоматична перевірка типів у TypeScript, яка ловить частину помилок ще до запуску." },
    ],
  },
  {
    title: "Збирання, розгортання, бекенд",
    terms: [
      { word: "збілдити, білд", origin: "build", meaning: "Зібрати проєкт у готовий до запуску вигляд і сам результат збирання." },
      { word: "задеплоїти, деплой", origin: "deploy", meaning: "Розгорнути застосунок на сервері чи в хмарі, щоб ним могли користуватися." },
      { word: "пайплайн", origin: "pipeline", meaning: "Автоматичний ланцюжок кроків: збирання, тести, розгортання." },
      { word: "артефакт", origin: "artifact", meaning: "Результат збирання, який далі розгортають (архів, пакет, набір файлів)." },
      { word: "прод, продакшн", origin: "production", meaning: "Робоче середовище, яким користуються справжні користувачі." },
      { word: "дев, стейдж", origin: "development, staging", meaning: "Тестові середовища: для розробки та для фінальної перевірки перед продом." },
      { word: "енв, енвайрмент", origin: "environment", meaning: "Середовище, де запущено застосунок, або набір змінних налаштувань." },
      { word: "ендпоінт", origin: "endpoint", meaning: "Адреса API, на яку надсилають запит: метод плюс шлях." },
      { word: "реквест", origin: "request", meaning: "Запит від клієнта до сервера." },
      { word: "респонс", origin: "response", meaning: "Відповідь сервера на запит: код статусу і дані." },
      { word: "хендлер", origin: "handler", meaning: "Функція, яка обробляє конкретний запит чи подію." },
      { word: "задебажити, дебаг", origin: "debug", meaning: "Шукати й виправляти причину помилки, зокрема покроково." },
      { word: "бага", origin: "bug", meaning: "Помилка в програмі." },
      { word: "пофіксити, фікс", origin: "fix", meaning: "Виправити помилку і саме виправлення." },
      { word: "хотфікс", origin: "hotfix", meaning: "Термінове виправлення, яке випускають у прод поза звичайним циклом." },
      { word: "закешувати", origin: "cache", meaning: "Зберегти результат, щоб наступного разу віддати його швидше." },
      { word: "засетапити", origin: "to set up", meaning: "Налаштувати середовище, інструмент чи сервіс." },
      { word: "логи", origin: "logs", meaning: "Записи про те, що відбувалося в програмі. По них шукають причини збоїв." },
    ],
  },
  {
    title: "Фронтенд",
    terms: [
      { word: "верстка, верстати", origin: "markup, layout coding", meaning: "Перетворення макета на HTML і CSS. «Зверстати екран за макетом у Figma»." },
      { word: "семантика", origin: "semantic HTML", meaning: "Використання тегів за призначенням (header, article, button), щоб браузер, скрінрідер і пошуковик розуміли структуру сторінки." },
      { word: "ей-одинадцять-уай, доступність", origin: "a11y, accessibility", meaning: "Зручність інтерфейсу для всіх, зокрема для людей з порушеннями зору чи моторики." },
      { word: "скрінрідер", origin: "screen reader", meaning: "Програма, яка озвучує вміст екрана людям з порушеннями зору." },
      { word: "дом", origin: "DOM", meaning: "Дерево елементів сторінки в браузері, з яким працюють CSS і JavaScript." },
      { word: "спа", origin: "SPA, single page application", meaning: "Застосунок, який завантажується один раз і далі змінює сторінку без перезавантаження." },
      { word: "роутинг, роутер", origin: "routing, router", meaning: "Перемикання між сторінками застосунку за адресою без перезавантаження." },
      { word: "бандл", origin: "bundle", meaning: "Зібраний JavaScript-файл застосунку, який завантажує браузер." },
      { word: "лейзі-лоадінг", origin: "lazy loading", meaning: "Завантаження частини коду чи сторінки лише тоді, коли вона справді потрібна." },
      { word: "рендер, перерендер", origin: "render", meaning: "Відмалювання інтерфейсу і повторне відмалювання після зміни даних." },
      { word: "реактивність", origin: "reactivity", meaning: "Інтерфейс сам оновлюється, коли змінюються дані, від яких він залежить." },
      { word: "стейт", origin: "state", meaning: "Стан застосунку чи компонента: дані, від яких залежить, що показано на екрані." },
      { word: "хуки", origin: "hooks", meaning: "Функції React (useState, useEffect), через які компонент працює зі станом і побічними діями." },
      { word: "сигнали", origin: "signals", meaning: "Спосіб точкової реактивності: змінилось значення — оновилась лише частина, яка його читає." },
      { word: "тост", origin: "toast", meaning: "Невелике спливне сповіщення в кутку екрана: «Збережено», «Помилка мережі»." },
      { word: "моки, на моках", origin: "mocks", meaning: "Підставні тестові дані замість справжнього бекенду. «Перший рівень робимо на моках»." },
      { word: "препроцесор", origin: "preprocessor", meaning: "Надбудова над CSS (SCSS, Sass, Less) зі змінними й зручним синтаксисом, яка компілюється у звичайний CSS." },
      { word: "івент-луп", origin: "event loop", meaning: "Механізм, що по черзі виконує асинхронні задачі в однопотоковому JavaScript." },
    ],
  },
  {
    title: "Хмара й інфраструктура",
    terms: [
      { word: "клауд", origin: "cloud", meaning: "Хмара — сервери й сервіси провайдера, які орендують замість власного заліза." },
      { word: "фрітір", origin: "free tier", meaning: "Безкоштовний рівень хмарного провайдера з обмеженнями." },
      { word: "кости", origin: "costs", meaning: "Витрати на хмарні ресурси. «Подивись кости за місяць»." },
      { word: "білінг", origin: "billing", meaning: "Розділ хмари з рахунками й нарахуваннями." },
      { word: "інстанс", origin: "instance", meaning: "Окремий запущений екземпляр сервера чи сервісу." },
      { word: "бакет", origin: "bucket", meaning: "Контейнер для файлів у хмарному сховищі (наприклад, S3)." },
      { word: "тригер, тригерити", origin: "trigger", meaning: "Подія, яка запускає дію, і сам запуск. «Пайплайн тригериться на мерж»." },
      { word: "заскейлити", origin: "to scale", meaning: "Масштабувати: додати ресурсів під більше навантаження." },
      { word: "даунтайм", origin: "downtime", meaning: "Час, коли сервіс не працює." },
      { word: "алерт", origin: "alert", meaning: "Автоматичне сповіщення про проблему чи перевищення ліміту." },
      { word: "інцидент", origin: "incident", meaning: "Збій, на який команда має реагувати." },
    ],
  },
  {
    title: "Тестування й якість",
    terms: [
      { word: "кейс, тест-кейс", origin: "test case", meaning: "Опис перевірки: кроки, вхідні дані й очікуваний результат." },
      { word: "едж-кейс", origin: "edge case", meaning: "Граничний, рідкісний сценарій, про який легко забути." },
      { word: "хепі-пас", origin: "happy path", meaning: "Основний сценарій, коли все йде як задумано, без помилок." },
      { word: "замокати, мок", origin: "mock", meaning: "Підмінити справжню залежність імітацією, щоб протестувати код окремо." },
      { word: "юніт-тест", origin: "unit test", meaning: "Автоматичний тест однієї невеликої частини коду." },
      { word: "куа, тестувальник", origin: "QA", meaning: "Фахівець і напрям, що відповідає за якість і тестування." },
      { word: "баг-репорт", origin: "bug report", meaning: "Опис знайденої помилки: кроки відтворення, очікуваний і фактичний результат." },
      { word: "дефект", origin: "defect", meaning: "Невідповідність вимогам чи макету. На деяких проєктах так називають саме помилки, знайдені під час тестування нової user story." },
      { word: "регрес, регресія", origin: "regression testing", meaning: "Перевірка, що нові зміни й виправлення не зламали те, що вже працювало." },
      { word: "ретест, ретестити", origin: "retest", meaning: "Повторна перевірка виправленого дефекту." },
      { word: "пройшов, зафейлився", origin: "passed, failed", meaning: "Статуси тест-кейсу: перевірка успішна або знайдено дефект. «Другий кейс зафейлився»." },
      { word: "заблокований, скіпнутий", origin: "blocked, skipped", meaning: "Статуси тест-кейсу: перевірити неможливо через іншу проблему, або перевірку свідомо пропустили." },
      { word: "северіті", origin: "severity", meaning: "Серйозність дефекту: наскільки він шкодить системі (Blocker, Critical, Major, Minor)." },
      { word: "пріоритет", origin: "priority", meaning: "Як швидко треба виправити дефект (High, Medium, Low). Не те саме, що серйозність." },
      { word: "воркераунд", origin: "workaround", meaning: "Обхідний шлях, яким можна продовжити роботу попри дефект." },
      { word: "тест-дані", origin: "test data", meaning: "Заздалегідь підготовлені дані для перевірок: валідні й невалідні логіни, паролі, суми." },
      { word: "тестрейл", origin: "TestRail", meaning: "Система, де зберігають тест-кейси, групують їх і запускають, виставляючи статуси." },
      { word: "девтулзи", origin: "DevTools", meaning: "Інструменти розробника в браузері: елементи сторінки, консоль, мережеві запити." },
      { word: "емулятор", origin: "emulator", meaning: "Програмна імітація телефона чи планшета для перевірки застосунку на різних пристроях." },
    ],
  },
  {
    title: "Дизайн",
    terms: [
      { word: "флоу", origin: "flow", meaning: "Послідовність кроків користувача для досягнення мети. «Флоу бронювання»." },
      { word: "юзер", origin: "user", meaning: "Користувач." },
      { word: "вайрфрейм", origin: "wireframe", meaning: "Схематичний каркас екрана без кольорів і деталей." },
      { word: "лейаут", origin: "layout", meaning: "Розташування елементів на сторінці." },
      { word: "компонент", origin: "component", meaning: "Повторно використовуваний елемент інтерфейсу: кнопка, картка, поле." },
      { word: "дизайн-токени", origin: "design tokens", meaning: "Іменовані значення стилю (кольори, відступи, шрифти), спільні для дизайну й коду." },
      { word: "дизайн-система", origin: "design system", meaning: "Набір правил, токенів і компонентів, за якими будується весь інтерфейс." },
      { word: "ресьорч", origin: "research", meaning: "Дослідження користувачів, ринку чи конкурентів." },
      { word: "мікрокопі", origin: "microcopy", meaning: "Короткі тексти інтерфейсу: написи на кнопках, підказки, повідомлення про помилки." },
    ],
  },
  {
    title: "ШІ",
    terms: [
      { word: "промпт, промптити", origin: "prompt", meaning: "Запит до ШІ-моделі і дія його написання: задача, контекст, обмеження, формат результату." },
      { word: "агент", origin: "agent", meaning: "ШІ-система, яка сама планує кроки й користується інструментами: читає файли, змінює код, запускає команди." },
      { word: "субагент", origin: "subagent", meaning: "Агент, якого запускає інший агент для окремої частини задачі." },
      { word: "скіл", origin: "skill", meaning: "Набір інструкцій і скриптів, який агенти використовують повторно." },
      { word: "контекст", origin: "context", meaning: "Усе, що модель «бачить» під час відповіді: промпт, історія діалогу, файли." },
      { word: "токени", origin: "tokens", meaning: "Шматочки тексту, якими рахують обсяг роботи моделі — і її вартість." },
      { word: "галюцинувати", origin: "to hallucinate", meaning: "Про модель: впевнено вигадувати неіснуючі факти, функції чи посилання." },
      { word: "вайбкодинг", origin: "vibe coding", meaning: "Написання коду через ШІ без глибокого розуміння, що саме згенеровано. Зазвичай з іронією." },
    ],
  },
  {
    title: "Кар'єра й спілкування",
    terms: [
      { word: "джун, мідл, сеньйор", origin: "junior, middle, senior", meaning: "Рівні досвіду розробника: початківець, самостійний фахівець, експерт." },
      { word: "тімлід", origin: "team lead", meaning: "Керівник команди: розподіляє роботу, рев'юїть, відповідає за результат." },
      { word: "техлід", origin: "tech lead", meaning: "Людина, що відповідає за технічні рішення і якість реалізації в команді." },
      { word: "онбординг", origin: "onboarding", meaning: "Введення нової людини в проєкт і команду." },
      { word: "офер", origin: "offer", meaning: "Пропозиція роботи після співбесіди." },
      { word: "засінкатися, сінк", origin: "sync", meaning: "Коротко зустрітися, щоб звірити стан справ." },
      { word: "пошерити", origin: "to share", meaning: "Поділитися: екраном, файлом, посиланням. «Пошер, будь ласка, екран»." },
      { word: "зафоловапити, фоловап", origin: "follow-up", meaning: "Повернутися до питання після зустрічі; лист чи повідомлення з підсумками й наступними кроками." },
      { word: "дискасити", origin: "to discuss", meaning: "Обговорювати." },
      { word: "ПОК", origin: "PoC, proof of concept", meaning: "Невеликий прототип, щоб перевірити, чи ідея взагалі працює." },
    ],
  },
];

const sorted = groups.map((group) => ({
  ...group,
  terms: [...group.terms].sort((a, b) => a.word.localeCompare(b.word, "uk")),
}));

const total = groups.reduce((sum, group) => sum + group.terms.length, 0);
---

<BaseLayout pageTitle={pageTitle}>
  <p>
    Англіцизми й жаргон, які постійно звучать в ІТ-командах і на стрімах інтенсиву. У кожній
    картці: як кажуть у команді, англійський оригінал над словом і пояснення простими словами.
    Усього {total} слів, згрупованих за темами.
  </p>
  <p>
    Жаргон — нормальна частина робочої мови, але в документах і листах до замовника краще писати
    повні терміни: не «засайнили таску», а «призначили задачу».
  </p>

  {
    sorted.map((group) => (
      <section>
        <h2>{group.title}</h2>
        <ul class="card-grid">
          {group.terms.map((term) => (
            <Card label={term.origin} title={term.word} description={term.meaning} />
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
